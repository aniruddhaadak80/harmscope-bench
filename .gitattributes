# Normalise line endings on checkout so a Windows clone produces the same bytes as CI.
# The Python engine's golden-file test compares parsed JSON, but text fixtures and shell
# scripts are safer when they are not at the mercy of the contributor's core.autocrlf.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary, never normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.sqlite binary
*.db binary
