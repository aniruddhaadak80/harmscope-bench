# Copy to .env.local and fill in. Never commit .env.local.
# Every value here is intentionally EMPTY. check:no-secrets fails on non-empty values.

# Product
${PRODUCT_ENV=development}
${PRODUCT_DATA_DIR=.data

# Optional: an LLM provider. The product's deterministic engine needs none of these.
${ANTHROPIC_API_KEY=}
${OPENAI_API_KEY=}

# Optional: telemetry. Off unless set.
${TELEMETRY_ENABLED=false}
