{
  "name": "harmscope-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Harmscope Bench — Work an AI deployment review as a queue of contested harm claims, each of which can only advance through a state graph that refuses transitions the evidence does not support.",
  "license": "MIT",
  "author": "aniruddhaadak80",
  "repository": {
    "type": "git",
    "url": "https://github.com/aniruddhaadak80/harmscope-bench.git"
  },
  "homepage": "https://github.com/aniruddhaadak80/harmscope-bench",
  "bugs": {
    "url": "https://github.com/aniruddhaadak80/harmscope-bench/issues"
  },
  "type": "module",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": "\u003e=22.12.0",
    "npm": "\u003e=10"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "electron": true
  },
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "prepare": "prettier --write .",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "turbo run dev --parallel",
    "check:skill-version": "node scripts/check-skill-version.mjs",
    "check:no-secrets": "node scripts/check-no-secrets.mjs",
    "check:theme-tokens": "node scripts/check-theme-tokens.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:public-hygiene": "node scripts/check-public-hygiene.mjs",
    "check:readme-commands": "node scripts/check-readme-commands.mjs",
    "pytest": "python -m pytest services/engine -q",
    "check": "npm run format:check \u0026\u0026 npm run lint \u0026\u0026 npm run typecheck \u0026\u0026 npm run check:action-pins \u0026\u0026 npm run check:skill-version \u0026\u0026 npm run check:no-secrets \u0026\u0026 npm run check:theme-tokens \u0026\u0026 npm run check:boundaries \u0026\u0026 npm run check:public-hygiene \u0026\u0026 npm run check:readme-commands \u0026\u0026 npm test \u0026\u0026 npm run pytest \u0026\u0026 npm run build",
    "release": "node scripts/release.mjs",
    "check:action-pins": "node scripts/check-action-pins.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "cli",
    "typescript",
    "python",
    "self-hosted"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.0",
    "turbo": "^2.11.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3"
  }
}
